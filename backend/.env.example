# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/canteen

# JWT settings - change JWT_SECRET to a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Seeded staff account (used by seed.py)
SEED_STAFF_INSTITUTE_ID=STAFF001
SEED_STAFF_USERNAME=staff01
SEED_STAFF_PASSWORD=Staff@123

# Seeded main canteen admin account (used by seed.py, logs in at /auth/admin/login)
SEED_ADMIN_INSTITUTE_ID=ADMIN001
SEED_ADMIN_USERNAME=canteen_admin
SEED_ADMIN_PASSWORD=Admin@123

# Password recovery emails. Production (Render): Brevo HTTP API. Locally you can use SMTP
# instead (e.g. Gmail with an App Password). With neither, codes are printed to the server log.
EMAIL_FROM=
EMAIL_FROM_NAME=Canteen App
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Razorpay (test mode keys from the dashboard). The secret stays on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# auto = POST /orders needs a verified payment only when the keys above are set
PAYMENT_REQUIRED=auto
